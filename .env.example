# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# For Vercel/Neon/Supabase serverless use a pooled connection string, e.g.
# postgresql://user:pass@host/db?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/videoplatform?schema=public

# ---------------------------------------------------------------------------
# Redis (BullMQ queue)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# JWT / auth
# ---------------------------------------------------------------------------
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
# Access token lifetime in seconds (default 900 = 15 min)
JWT_ACCESS_TTL=900
# Refresh token lifetime in days
JWT_REFRESH_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# Authorized redirect URI in Google Console must be exactly:
#   <API_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---------------------------------------------------------------------------
# URLs / cookies
# ---------------------------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# In production web and api must be same-site (e.g. app.example.com and
# api.example.com). Set COOKIE_DOMAIN=.example.com to share the refresh cookie.
COOKIE_DOMAIN=
# Set to true when serving over HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# S3-compatible storage (MinIO locally, Selectel / Yandex / AWS in prod)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=videoplatform
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# If the bucket is public, set the public base URL (no trailing slash) to serve
# videos directly from storage. Leave empty to use short-lived presigned GETs.
PUBLIC_S3_BASE_URL=http://localhost:9000/videoplatform

# ---------------------------------------------------------------------------
# Moderation / roles
# ---------------------------------------------------------------------------
# If true, new posts stay unpublished until approved by a moderator.
PREMODERATION=false
# Comma-separated Google emails that are granted ADMIN role on login.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Web (Next.js) - also copy into Vercel project env
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=1

{
  "name": "video-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @vp/api prisma:generate",
    "db:migrate": "pnpm --filter @vp/api prisma:migrate",
    "db:deploy": "pnpm --filter @vp/api prisma:deploy",
    "db:studio": "pnpm --filter @vp/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
